<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="ExcludeException" verbose="1">
  <test name="AllExceptException">
    <groups>
      <run>
        <exclude name="exception"/>
      </run>
    </groups>
    <classes>
      <class name="org.example.MainAppTest"/>
    </classes>
  </test>
</suite>
